package Main;

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner leitor = new Scanner(System.in);

        System.out.println("Tente adivinhar o numero que estou pensando, dica: e um numero de 0 a 10");

        int numeroSecreto = 9;
        int palpite = leitor.nextInt();

        if (palpite == numeroSecreto) {
            System.out.println("Parabens, leu minha mente");
        } else {
            System.out.println("Voce errou, era o numero 9");
        }

    }
}
